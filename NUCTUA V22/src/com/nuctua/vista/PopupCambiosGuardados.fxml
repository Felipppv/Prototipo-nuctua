<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nuctua.controlador.PopupCambiosGuardadosController" styleClass="capa-popup">
    <VBox styleClass="modal" alignment="CENTER" maxWidth="600" prefWidth="600" maxHeight="-Infinity">
        <StackPane fx:id="icono"/>
        <Label text="CAMBIOS GUARDADOS" styleClass="modal-titulo"/>
        <HBox styleClass="resumen-agregado" spacing="14" alignment="CENTER_LEFT">
            <StackPane fx:id="miniatura" styleClass="miniatura-agregado" minWidth="80" maxWidth="80" minHeight="66" maxHeight="66"/>
            <VBox spacing="2" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="0">
                <Label fx:id="nombre" styleClass="nombre-pedido" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="detalle" styleClass="texto" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </HBox>
        <Label fx:id="mensaje" wrapText="true" minHeight="-Infinity" styleClass="texto-agregado" style="-fx-text-alignment: center;"/>
        <Button text="LISTO" styleClass="boton-primario" defaultButton="true" onAction="#cerrar"/>
    </VBox>
</StackPane>
