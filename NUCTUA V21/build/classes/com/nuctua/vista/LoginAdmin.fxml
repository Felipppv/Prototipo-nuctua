<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.CampoContrasena?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.LoginAdminController"
            fitToWidth="true" fitToHeight="true" styleClass="scroll-pagina">
    <StackPane styleClass="pagina-acceso" minHeight="760">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        <VBox spacing="14" maxWidth="440" prefWidth="440" alignment="CENTER_LEFT">
            <Hyperlink fx:id="enlaceVolver" text="← Volver al acceso de clientes" styleClass="enlace-texto" onAction="#irALogin"/>
            <VBox spacing="-40">
                <Label text="BIENVENIDO A" styleClass="titulo-acceso"/>
                <HBox>
                    <Label text="NUCTUA" styleClass="titulo-acceso"/>
                    <Label text="." styleClass="titulo-acceso, punto-naranja"/>
                </HBox>
            </VBox>
            <Label text="Inicia sesión para acceder como administrador de NUCTUA." wrapText="true" minHeight="-Infinity" styleClass="subtitulo"/>
            <VBox spacing="8">
                <Label text="CORREO ELECTRÓNICO" styleClass="etiqueta-campo"/>
                <TextField fx:id="campoCorreo" promptText="tu@correo.com" styleClass="campo"/>
            </VBox>
            <VBox spacing="8">
                <Label text="CONTRASEÑA" styleClass="etiqueta-campo"/>
                <CampoContrasena fx:id="campoContrasena" prompt="Introduce tu contraseña"/>
            </VBox>
            <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" visible="false" managed="false"/>
            <Button fx:id="botonIngresar" text="INICIAR SESIÓN" maxWidth="Infinity"
                    styleClass="boton-primario" defaultButton="true"/>
            <HBox fx:id="filaSeguridad" alignment="CENTER"/>
        </VBox>
    </StackPane>
</ScrollPane>
