<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.Cinta?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.CarritoController" styleClass="pagina">
    <top>
        <fx:include fx:id="barra" source="BarraCliente.fxml"/>
    </top>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="scroll-pagina">
            <VBox styleClass="contenido">
                <Hyperlink fx:id="enlaceSeguir" text="Seguir comprando" styleClass="enlace-texto, enlace-volver"/>
                <VBox spacing="10">
                    <Label fx:id="sello" styleClass="pastilla, sello-inclinado"/>
                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="TU CARRITO" styleClass="titulo-gigante, titulo-deseos"/>
                        <Label text="." styleClass="titulo-gigante, titulo-deseos, texto-naranja"/>
                    </HBox>
                    <Label text="Revisa tus pares, ajusta talla y cantidad, y sigue al pago cuando estés listo."
                           styleClass="subtitulo, texto-suave-grande" wrapText="true" maxWidth="640" minHeight="-Infinity"/>
                </VBox>
                <HBox fx:id="aviso" styleClass="aviso-deseos" visible="false" managed="false">
                    <Label fx:id="textoAviso" styleClass="texto, negrita" wrapText="true"/>
                </HBox>
                <HBox spacing="32" alignment="TOP_LEFT">
                    <VBox spacing="24" HBox.hgrow="ALWAYS" minWidth="0">
                        <VBox fx:id="productos" spacing="24"/>
                        <VBox fx:id="tarjetaVacia" styleClass="tarjeta-punteada, carrito-vacio" spacing="14" alignment="CENTER"
                              visible="false" managed="false">
                            <Label text="TU CARRITO ESTÁ VACÍO" styleClass="titulo-explorar"/>
                            <Label text="Agrega un par desde el catálogo o desde tu lista de deseos." styleClass="subtitulo"/>
                            <Button fx:id="botonCatalogo" text="IR AL CATÁLOGO" styleClass="boton-primario"/>
                        </VBox>
                        <HBox styleClass="tarjeta-punteada, carrito-falta" alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="¿TE FALTA UN PAR?" styleClass="titulo-chico, titulo-falta"/>
                                <Label text="Revisa los pares que guardaste en tu lista de deseos." styleClass="texto-suave-grande, texto-falta"
                                       wrapText="true" minHeight="-Infinity"/>
                            </VBox>
                            <Button fx:id="botonDeseosCarrito" text="VER LISTA DE DESEOS" styleClass="boton-secundario, boton-ver-deseos"
                                    minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="tarjeta, resumen-carrito" spacing="18" prefWidth="440" minWidth="330" maxWidth="440" maxHeight="-Infinity">
                        <Label text="RESUMEN" styleClass="titulo"/>
                        <fx:include fx:id="resumen" source="ResumenCompra.fxml"/>
                        <Button fx:id="botonPagar" text="IR A PAGAR" styleClass="boton-primario, boton-pagar" maxWidth="Infinity"/>
                        <Label fx:id="mensajePago" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity" visible="false" managed="false"/>
                        <HBox spacing="8" alignment="CENTER">
                            <StackPane fx:id="iconoSeguridad"/>
                            <Label text="Pago seguro. Tus datos, siempre protegidos." styleClass="texto-suave" wrapText="true" minHeight="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>
                <Cinta>
                    <VBox.margin>
                        <Insets left="-64" right="-64" bottom="-48" top="24"/>
                    </VBox.margin>
                </Cinta>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
