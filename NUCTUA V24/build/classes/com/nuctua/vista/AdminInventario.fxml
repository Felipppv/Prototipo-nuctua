<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.Cinta?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.AdminInventarioController" styleClass="pagina">
    <top>
        <fx:include fx:id="barra" source="BarraAdmin.fxml"/>
    </top>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="scroll-pagina">
            <VBox styleClass="contenido, contenido-admin">
                <Hyperlink fx:id="enlaceVolver" text="Volver a la tienda" styleClass="enlace-texto, enlace-volver"/>
                <VBox spacing="4">
                    <Label fx:id="sello" styleClass="pastilla, pastilla-admin, sello-inclinado"/>
                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="INVENTARIO" styleClass="titulo-gigante, titulo-deseos"/>
                        <Label text="." styleClass="titulo-gigante, titulo-deseos, texto-naranja"/>
                    </HBox>
                    <Label text="Revisa tu stock, ajusta cantidades y guarda cuando estés listo."
                           styleClass="subtitulo, texto-suave-grande" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <HBox fx:id="aviso" styleClass="aviso-deseos" visible="false" managed="false">
                    <Label fx:id="textoAviso" styleClass="texto, negrita" wrapText="true" minHeight="-Infinity"/>
                </HBox>
                <HBox spacing="24" alignment="TOP_LEFT">
                    <VBox spacing="18" HBox.hgrow="ALWAYS" minWidth="0" prefWidth="912">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <HBox styleClass="buscador-admin" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS" minWidth="150">
                                <StackPane fx:id="iconoBuscar"/>
                                <TextField fx:id="campoBuscar" promptText="Buscar producto o SKU" styleClass="buscador-campo" HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <HBox fx:id="filtros" spacing="8" minWidth="-Infinity"/>
                        </HBox>
                        <VBox fx:id="lista" spacing="18"/>
                        <VBox fx:id="listaVacia" styleClass="tarjeta-punteada, otro-par" spacing="6" alignment="CENTER" visible="false" managed="false">
                            <Label text="SIN RESULTADOS" styleClass="titulo-chico"/>
                            <Label text="Ningún par coincide con tu búsqueda y el filtro elegido." styleClass="texto-suave"/>
                        </VBox>
                        <HBox styleClass="tarjeta-punteada, carrito-falta" alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="¿LLEGÓ MERCANCÍA NUEVA?" styleClass="titulo-chico"/>
                                <Label text="Registra un ingreso o crea un modelo con sus tallas y colores." styleClass="texto, texto-suave-grande"
                                       wrapText="true" minHeight="-Infinity"/>
                            </VBox>
                            <Button fx:id="botonNuevo" text="NUEVO PRODUCTO" styleClass="boton-secundario" minWidth="-Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox styleClass="tarjeta, tarjeta-resumen-admin" minWidth="250" prefWidth="280" maxWidth="280" maxHeight="-Infinity">
                        <Label text="RESUMEN" styleClass="titulo"/>
                        <HBox>
                            <Label text="Pares en bodega" styleClass="texto, texto-suave-grande"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cifraPares" styleClass="texto, negrita"/>
                        </HBox>
                        <HBox>
                            <Label text="Modelos activos" styleClass="texto, texto-suave-grande"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cifraActivos" styleClass="texto, negrita"/>
                        </HBox>
                        <HBox>
                            <Label text="Poco stock" styleClass="texto, texto-suave-grande"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cifraPoco" styleClass="texto, negrita"/>
                        </HBox>
                        <HBox>
                            <Label text="Agotados" styleClass="texto, texto-suave-grande"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cifraAgotados" styleClass="texto, negrita"/>
                        </HBox>
                        <Region styleClass="separador"/>
                        <VBox>
                            <Label text="CAMBIOS SIN GUARDAR" styleClass="etiqueta-campo, texto-suave-grande"/>
                            <Label fx:id="cifraCambios" styleClass="cifra-cambios"/>
                        </VBox>
                        <Button fx:id="botonGuardar" text="GUARDAR CAMBIOS" styleClass="boton-primario, boton-cuadrado" maxWidth="Infinity"/>
                        <HBox alignment="CENTER">
                            <Hyperlink fx:id="enlaceDescartar" text="Descartar cambios" styleClass="enlace-texto"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <StackPane fx:id="iconoSeguridad"/>
                            <Label text="La tienda se actualiza al guardar." styleClass="texto-suave" wrapText="true" minHeight="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>
                <Cinta>
                    <VBox.margin>
                        <Insets left="-80" right="-80" bottom="-48" top="24"/>
                    </VBox.margin>
                </Cinta>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
