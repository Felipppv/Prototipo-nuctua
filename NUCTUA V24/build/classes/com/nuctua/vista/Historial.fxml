<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.Cinta?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.HistorialController" styleClass="pagina">
    <top>
        <fx:include fx:id="barra" source="BarraCliente.fxml"/>
    </top>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="scroll-pagina">
            <VBox styleClass="contenido" alignment="TOP_CENTER">
                <VBox alignment="TOP_CENTER" spacing="10">
                    <Hyperlink fx:id="enlaceVolver" styleClass="enlace-texto"/>
                    <Label fx:id="contador" styleClass="pastilla, pastilla-contador"/>
                </VBox>
                <VBox spacing="28" maxWidth="1060">
                    <VBox spacing="2">
                        <HBox alignment="BASELINE_LEFT">
                            <Label text="TU HISTORIAL" styleClass="titulo-gigante, titulo-historial"/>
                            <Label text="." styleClass="titulo-gigante, titulo-historial, texto-naranja"/>
                        </HBox>
                        <Label text="Tus compras confirmadas y los últimos pares que abriste, del más reciente al más antiguo."
                               styleClass="texto-suave-grande" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                    <HBox fx:id="aviso" styleClass="aviso-deseos" visible="false" managed="false">
                        <Label fx:id="textoAviso" styleClass="texto, negrita" wrapText="true" minHeight="-Infinity"/>
                        <Hyperlink fx:id="enlaceAviso" text="Ver el par" styleClass="enlace-texto" minWidth="-Infinity"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="HISTORIAL DE" styleClass="titulo-chico"/>
                        <Label text="COMPRA" styleClass="titulo-chico, texto-naranja"/>
                    </HBox>
                    <VBox fx:id="compras" spacing="20"/>
                    <VBox fx:id="comprasVacias" styleClass="tarjeta-punteada, otro-par" spacing="8" alignment="CENTER"
                          visible="false" managed="false">
                        <Label text="AÚN NO TIENES PEDIDOS" styleClass="titulo-chico"/>
                        <Label text="Cuando confirmes una compra, aquí verás su estado y su factura." styleClass="texto-suave"/>
                    </VBox>
                    <VBox fx:id="seccionVistos" spacing="24">
                        <HBox spacing="6">
                            <Label text="VISTOS" styleClass="titulo-chico"/>
                            <Label text="RECIENTEMENTE" styleClass="titulo-chico, texto-naranja"/>
                        </HBox>
                        <FlowPane fx:id="vistos" hgap="16" vgap="20"/>
                    </VBox>
                    <VBox styleClass="tarjeta-punteada, otro-par" spacing="8" alignment="CENTER">
                        <Label text="¿BUSCAS OTRO PAR?" styleClass="titulo-chico"/>
                        <Label text="Vuelve al catálogo, filtra por talla o precio y guarda tus favoritos en la lista de deseos."
                               styleClass="texto-suave" wrapText="true" minHeight="-Infinity"/>
                        <Button fx:id="botonCatalogo" text="IR AL CATÁLOGO →" styleClass="boton-agregar">
                            <VBox.margin>
                                <Insets top="6"/>
                            </VBox.margin>
                        </Button>
                    </VBox>
                </VBox>
                <Cinta>
                    <VBox.margin>
                        <Insets left="-64" right="-64" bottom="-48" top="16"/>
                    </VBox.margin>
                </Cinta>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
