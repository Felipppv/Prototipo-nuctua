<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.Cinta?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.ListaDeseosController" styleClass="pagina">
    <top>
        <fx:include fx:id="barra" source="BarraCliente.fxml"/>
    </top>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="scroll-pagina">
            <VBox styleClass="contenido">
                <Hyperlink fx:id="enlaceVolver" text="Volver al catálogo" styleClass="enlace-texto, enlace-volver"/>
                <HBox alignment="BOTTOM_LEFT">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Tu lista guardada" styleClass="pastilla, sello-inclinado"/>
                        <Label text="LISTA DE DESEOS." styleClass="titulo-gigante, titulo-deseos"/>
                        <Label text="Los pares que guardaste con el corazón, listos para pasar al carrito cuando quieras."
                               styleClass="subtitulo, texto-suave-grande" wrapText="true" maxWidth="640" minHeight="-Infinity"/>
                    </VBox>
                    <VBox spacing="10" alignment="BOTTOM_RIGHT">
                        <Label fx:id="contador" styleClass="texto, negrita"/>
                        <Button fx:id="botonOrdenar" styleClass="combo, combo-grande"/>
                        <Label fx:id="infoRecorrido" styleClass="info-orden"/>
                    </VBox>
                </HBox>
                <HBox fx:id="aviso" styleClass="aviso-deseos" visible="false" managed="false">
                    <Label fx:id="textoAviso" styleClass="texto, negrita"/>
                    <Hyperlink fx:id="enlaceDeshacer" text="Deshacer" styleClass="enlace-texto"/>
                </HBox>
                <HBox fx:id="barraRecorrido" styleClass="barra-recorrido" maxWidth="-Infinity">
                    <Button fx:id="botonAnterior" text="ANTERIOR" styleClass="boton-recorrido"/>
                    <Label fx:id="textoRecorrido" styleClass="texto, negrita"/>
                    <Button fx:id="botonSiguiente" text="SIGUIENTE" styleClass="boton-recorrido"/>
                </HBox>
                <FlowPane fx:id="grilla" hgap="28" vgap="28"/>
                <Cinta>
                    <VBox.margin>
                        <Insets left="-64" right="-64" bottom="-48" top="24"/>
                    </VBox.margin>
                </Cinta>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
