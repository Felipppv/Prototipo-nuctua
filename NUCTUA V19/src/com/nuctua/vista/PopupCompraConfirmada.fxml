<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nuctua.controlador.PopupCompraConfirmadaController" styleClass="capa-popup">
    <VBox styleClass="modal" alignment="CENTER" maxWidth="600" prefWidth="600" maxHeight="-Infinity">
        <StackPane fx:id="icono"/>
        <Label fx:id="pastilla" styleClass="pastilla-borde, pastilla-pedido"/>
        <Label text="¡COMPRA CONFIRMADA!" styleClass="modal-titulo"/>
        <Label fx:id="mensaje" wrapText="true" minHeight="-Infinity" styleClass="texto-agregado" style="-fx-text-alignment: center;"/>
        <HBox spacing="14" alignment="CENTER">
            <Button text="VER MI HISTORIAL →" styleClass="boton-primario" defaultButton="true" onAction="#verHistorial"/>
            <Button text="SEGUIR COMPRANDO" styleClass="boton-secundario" cancelButton="true" onAction="#cerrar"/>
        </HBox>
        <Hyperlink text="Ver mi factura" styleClass="enlace-texto" onAction="#verFactura"/>
    </VBox>
</StackPane>
