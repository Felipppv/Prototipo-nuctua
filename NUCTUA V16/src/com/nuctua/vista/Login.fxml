<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.CampoContrasena?>
<?import com.nuctua.util.Cinta?>
<?import com.nuctua.util.Huellas?>
<?import com.nuctua.util.SelloCircular?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.LoginController"
            fitToWidth="true" fitToHeight="true" styleClass="scroll-pagina">
    <HBox styleClass="pagina-acceso" spacing="56" minHeight="780">
        <padding>
            <Insets top="24" right="48" bottom="24" left="24"/>
        </padding>
        <VBox fx:id="panel" styleClass="panel-login" spacing="16" prefWidth="580" minWidth="520" maxWidth="620">
            <Label text="NUCTUA" styleClass="titulo-chico"/>
            <Region minHeight="24"/>
            <VBox spacing="-20">
                <Label text="PASO A PASO," styleClass="titulo-login"/>
                <HBox spacing="18" alignment="CENTER_LEFT">
                    <Label text="CON" styleClass="titulo-login"/>
                    <StackPane styleClass="marco-login" rotate="-1.5">
                        <Label text="NUCTUA." styleClass="titulo-login"/>
                    </StackPane>
                </HBox>
            </VBox>
            <Label text="Entra a tu cuenta de Nuctua y retoma tu compra en un instante."
                   wrapText="true" maxWidth="330" minHeight="-Infinity" styleClass="subtitulo"/>
            <StackPane alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS" minHeight="210">
                <Huellas/>
                <SelloCircular/>
            </StackPane>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Region minWidth="34" minHeight="2" maxHeight="2" style="-fx-background-color: #1B1410;"/>
                <Label text="Diseño, comodidad y calzado pensado para ti." styleClass="texto"/>
            </HBox>
            <Cinta>
                <VBox.margin>
                    <Insets left="-44" right="-44" bottom="34"/>
                </VBox.margin>
            </Cinta>
        </VBox>
        <VBox HBox.hgrow="ALWAYS" spacing="0">
            <HBox alignment="CENTER_RIGHT" spacing="6">
                <padding>
                    <Insets top="18" right="24"/>
                </padding>
                <Hyperlink fx:id="enlaceAdmin" text="ADMIN" styleClass="enlace-texto" onAction="#irALoginAdmin"/>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <VBox styleClass="columna-formulario">
                    <Label text="¡Qué bueno verte de nuevo!" styleClass="pastilla" rotate="-2"/>
                    <VBox spacing="-40">
                        <Label text="BIENVENIDO A" styleClass="titulo-acceso"/>
                        <HBox>
                            <Label text="NUCTUA" styleClass="titulo-acceso"/>
                            <Label text="." styleClass="titulo-acceso, punto-naranja"/>
                        </HBox>
                    </VBox>
                    <Label text="Inicia sesión para ver el catálogo, tu carrito, tus pedidos y tu lista de deseos."
                           wrapText="true" minHeight="-Infinity" styleClass="texto"/>
                    <Region minHeight="4"/>
                    <VBox spacing="8">
                        <Label text="CORREO ELECTRÓNICO" styleClass="etiqueta-campo"/>
                        <TextField fx:id="campoCorreo" promptText="tu@correo.com" styleClass="campo"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="CONTRASEÑA" styleClass="etiqueta-campo"/>
                        <CampoContrasena fx:id="campoContrasena" prompt="Introduce tu contraseña"/>
                    </VBox>
                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="checkRecordar" text="Recuérdame" styleClass="check"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="enlaceOlvido" text="¿Olvidaste tu contraseña?" styleClass="enlace-texto"/>
                    </HBox>
                    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" visible="false" managed="false"/>
                    <Button fx:id="botonIngresar" text="INICIAR SESIÓN" maxWidth="Infinity"
                            styleClass="boton-primario" defaultButton="true"/>
                    <HBox spacing="5" alignment="CENTER">
                        <Label text="¿Aún no tienes cuenta?" styleClass="texto"/>
                        <Hyperlink text="Regístrate" styleClass="enlace-texto" onAction="#irARegistro"/>
                    </HBox>
                    <HBox fx:id="filaSeguridad" spacing="8" alignment="CENTER">
                        <Label text="Tus datos, siempre protegidos." styleClass="texto-suave"/>
                    </HBox>
                </VBox>
            </StackPane>
            <HBox alignment="CENTER_LEFT">
                <Label text="Un acceso sencillo. Una conexión segura." styleClass="pie"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Español - ES" styleClass="pie"/>
            </HBox>
        </VBox>
    </HBox>
</ScrollPane>
