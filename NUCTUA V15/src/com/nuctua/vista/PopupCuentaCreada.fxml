<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nuctua.controlador.PopupCuentaCreadaController" styleClass="capa-popup">
    <VBox styleClass="modal" alignment="CENTER" maxWidth="560" prefWidth="560" maxHeight="-Infinity">
        <StackPane fx:id="icono"/>
        <Label text="¡CUENTA CREADA!" styleClass="modal-titulo"/>
        <Label fx:id="mensaje" wrapText="true" minHeight="-Infinity" styleClass="subtitulo" style="-fx-text-alignment: center;"/>
        <Button fx:id="botonIr" text="IR A INICIAR SESIÓN" styleClass="boton-primario" defaultButton="true" onAction="#cerrar"/>
    </VBox>
</StackPane>
