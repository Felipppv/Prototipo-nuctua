<?xml version="1.0" encoding="UTF-8"?>

<?import com.nuctua.util.Cinta?>
<?import com.nuctua.vista.CampoFormulario?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nuctua.controlador.PagoController" styleClass="pagina">
    <top>
        <fx:include fx:id="barra" source="BarraCliente.fxml"/>
    </top>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" styleClass="scroll-pagina">
            <VBox styleClass="contenido">
                <Hyperlink fx:id="enlaceVolver" text="Volver al carrito" styleClass="enlace-texto, enlace-volver"/>
                <VBox spacing="10">
                    <Label text="Último paso" styleClass="pastilla, sello-inclinado"/>
                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="CASI TUYOS" styleClass="titulo-gigante, titulo-deseos"/>
                        <Label text="." styleClass="titulo-gigante, titulo-deseos, texto-naranja"/>
                    </HBox>
                    <Label text="Completa tus datos de envío y elige cómo pagar. Ya casi estrenas."
                           styleClass="subtitulo, texto-suave-grande" wrapText="true" maxWidth="640" minHeight="-Infinity"/>
                </VBox>
                <HBox fx:id="aviso" styleClass="aviso-deseos" visible="false" managed="false">
                    <Label fx:id="textoAviso" styleClass="texto, negrita" wrapText="true"/>
                </HBox>
                <HBox spacing="32" alignment="TOP_LEFT">
                    <VBox HBox.hgrow="ALWAYS" minWidth="0" prefWidth="830">
                        <VBox fx:id="formularios" spacing="28">
                            <VBox styleClass="tarjeta, tarjeta-pago">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="1" styleClass="paso"/>
                                    <Label text="DATOS DE ENVÍO" styleClass="titulo-chico, titulo-paso"/>
                                </HBox>
                                <GridPane hgap="20" vgap="20">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>
                                    <CampoFormulario fx:id="campoNombre" etiqueta="NOMBRE COMPLETO" prompt="Tu nombre y apellido"/>
                                    <CampoFormulario fx:id="campoTelefono" etiqueta="TELÉFONO" prompt="Ej. 300 456 7812" GridPane.columnIndex="1"/>
                                    <CampoFormulario fx:id="campoCorreo" etiqueta="CORREO ELECTRÓNICO" prompt="tu@correo.com" GridPane.rowIndex="1"/>
                                    <CampoFormulario fx:id="campoCiudad" etiqueta="CIUDAD" prompt="Montería" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <CampoFormulario fx:id="campoDireccion" etiqueta="DIRECCIÓN" prompt="Ej. Calle 41 # 6-25" GridPane.rowIndex="2"/>
                                    <CampoFormulario fx:id="campoIndicaciones" etiqueta="BARRIO / INDICACIONES" prompt="Apto, torre, referencia"
                                                     GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                </GridPane>
                                <CheckBox fx:id="checkGuardar" text="Guardar estos datos para mi próxima compra" styleClass="check"/>
                            </VBox>
                            <VBox styleClass="tarjeta, tarjeta-pago">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="2" styleClass="paso"/>
                                    <Label text="MÉTODO DE PAGO" styleClass="titulo-chico, titulo-paso"/>
                                </HBox>
                                <GridPane fx:id="opciones" hgap="20" vgap="22">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" fillWidth="true"/>
                                        <ColumnConstraints percentWidth="50" fillWidth="true"/>
                                    </columnConstraints>
                                </GridPane>
                                <VBox fx:id="datosTarjeta" spacing="20">
                                    <CampoFormulario fx:id="campoNumero" etiqueta="NÚMERO DE TARJETA" prompt="0000 0000 0000 0000"/>
                                    <GridPane hgap="20">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="34"/>
                                            <ColumnConstraints percentWidth="33"/>
                                            <ColumnConstraints percentWidth="33"/>
                                        </columnConstraints>
                                        <CampoFormulario fx:id="campoTitular" etiqueta="NOMBRE EN LA TARJETA" prompt="Como aparece en la tarjeta"/>
                                        <CampoFormulario fx:id="campoVence" etiqueta="VENCE" prompt="MM / AA" GridPane.columnIndex="1"/>
                                        <CampoFormulario fx:id="campoCvv" etiqueta="CVV" prompt="123" secreto="true" GridPane.columnIndex="2"/>
                                    </GridPane>
                                </VBox>
                                <HBox fx:id="datosPse" spacing="20">
                                    <CampoFormulario fx:id="campoBanco" etiqueta="BANCO" prompt="Elige tu banco" prefWidth="300" HBox.hgrow="ALWAYS"/>
                                    <CampoFormulario fx:id="campoDocumento" etiqueta="DOCUMENTO DEL TITULAR" prompt="Ej. 1067890123" prefWidth="300"
                                                     HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <VBox fx:id="datosNequi" maxWidth="380">
                                    <CampoFormulario fx:id="campoCelular" etiqueta="CELULAR NEQUI" prompt="Ej. 300 456 7812"/>
                                </VBox>
                                <Label fx:id="datosContraEntrega" styleClass="texto" wrapText="true" minHeight="-Infinity"
                                       text="Ten el valor exacto listo. Le pagas al mensajero cuando recibas tus pares."/>
                            </VBox>
                        </VBox>
                        <VBox fx:id="tarjetaVacia" styleClass="tarjeta-punteada, carrito-vacio" spacing="14" alignment="CENTER"
                              visible="false" managed="false">
                            <Label text="NO HAY NADA POR PAGAR" styleClass="titulo-explorar"/>
                            <Label text="Agrega un par a tu carrito y vuelve para terminar tu compra." styleClass="subtitulo"/>
                            <Button fx:id="botonCatalogo" text="IR AL CATÁLOGO" styleClass="boton-primario"/>
                        </VBox>
                    </VBox>
                    <VBox styleClass="tarjeta, resumen-carrito" spacing="18" prefWidth="440" minWidth="330" maxWidth="440" maxHeight="-Infinity">
                        <Label text="RESUMEN" styleClass="titulo"/>
                        <VBox fx:id="miniaturas" spacing="14"/>
                        <fx:include fx:id="resumen" source="ResumenCompra.fxml"/>
                        <Button fx:id="botonConfirmar" text="CONFIRMAR PEDIDO" styleClass="boton-primario, boton-pagar" maxWidth="Infinity"/>
                        <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" minHeight="-Infinity" visible="false" managed="false"/>
                        <HBox spacing="8" alignment="CENTER">
                            <StackPane fx:id="iconoSeguridad"/>
                            <Label text="Pago seguro. Tus datos, siempre protegidos." styleClass="texto-suave" wrapText="true" minHeight="-Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>
                <Cinta>
                    <VBox.margin>
                        <Insets left="-64" right="-64" bottom="-48" top="24"/>
                    </VBox.margin>
                </Cinta>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
