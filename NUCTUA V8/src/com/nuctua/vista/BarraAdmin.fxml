<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nuctua.controlador.BarraAdminController" styleClass="barra" alignment="CENTER_LEFT">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="NUCTUA" styleClass="logo"/>
        <Label text="ADMIN" styleClass="etiqueta-admin"/>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox spacing="30" alignment="CENTER">
        <Button fx:id="enlaceInventario" text="Inventario" styleClass="enlace" onAction="#irAInventario"/>
        <Button fx:id="enlacePedidos" text="Pedidos" styleClass="enlace" onAction="#irAPedidos"/>
        <Button fx:id="enlaceProductos" text="Productos" styleClass="enlace" onAction="#irAProductos"/>
        <Button fx:id="enlaceClientes" text="Clientes" styleClass="enlace" onAction="#irAClientes"/>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox spacing="6" alignment="CENTER_RIGHT">
        <Button fx:id="botonBuscar" styleClass="boton-barra" onAction="#irABuscar"/>
        <Button fx:id="botonAvisos" styleClass="boton-barra, boton-barra-activo" onAction="#irAPedidos"/>
        <Button fx:id="botonPerfil" styleClass="boton-barra" onAction="#irAPerfil"/>
        <Button fx:id="botonSalir" styleClass="boton-barra" onAction="#cerrarSesion"/>
    </HBox>
</HBox>
