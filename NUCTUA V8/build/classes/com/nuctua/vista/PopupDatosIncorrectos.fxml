<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.nuctua.controlador.PopupDatosIncorrectosController" styleClass="capa-popup">
    <VBox styleClass="modal" alignment="CENTER" maxWidth="560" prefWidth="560" maxHeight="-Infinity">
        <StackPane fx:id="icono"/>
        <Label fx:id="titulo" text="DATOS INCORRECTOS" styleClass="modal-titulo" wrapText="true"/>
        <Label fx:id="mensaje" text="El correo o la contraseña no coinciden con ninguna cuenta. Revisa e inténtalo de nuevo."
               wrapText="true" minHeight="-Infinity" styleClass="subtitulo" style="-fx-text-alignment: center;"/>
        <Button fx:id="botonReintentar" text="VOLVER A INTENTAR" styleClass="boton-primario"
                defaultButton="true" onAction="#cerrar"/>
    </VBox>
</StackPane>
